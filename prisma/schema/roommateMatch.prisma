

model RoommateMatch {
  id           String      @id @default(uuid())
  tenantId     String      
  tenant       User        @relation("SeekingRoommate", fields: [tenantId], references: [id])
  matchedWithId String     
  matchedWith   User       @relation("PotentialRoommate", fields: [matchedWithId], references: [id])
  roomId       String?
  room         Room?       @relation(fields: [roomId], references: [id])
  score        Float       
  status       MatchStatus @default(PENDING)
  matchedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, matchedWithId])
  @@index([tenantId])
  @@index([matchedWithId])
  @@index([roomId])
  @@index([status])
  @@index([score])
  @@index([createdAt])
  @@index([deletedAt])
}