model UtilityBill {
  id            String            @id @default(uuid())
  roomId        String
  room          Room              @relation(fields: [roomId], references: [id])
  type          UtilityType
  amount        Float
  currency      String            @default("BDT")
  billingPeriod DateTime          
  dueDate       DateTime
  status        UtilityBillStatus @default(PENDING)
  billUrl       String?           
  notes         String?
  splits        UtilityBillSplit[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([roomId])
  @@index([type])
  @@index([status])
  @@index([billingPeriod])
  @@index([dueDate])
  @@index([createdAt])
}

